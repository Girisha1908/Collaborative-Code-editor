# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://coco:coco@localhost:5432/coco

# Sandbox tuning (optional)
SANDBOX_IMAGE=coco-sandbox:latest
SANDBOX_RUN_TIMEOUT=10
SANDBOX_IDLE_MS=300000
SANDBOX_MAX=20
MAX_TERMINALS_PER_ROOM=8

# Local AI assistant (Ollama by default; llama.cpp `llama-server` also works)
LLM_URL=http://localhost:11434
LLM_MODEL=qwen2.5-coder:3b
EMBED_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
RAG_TOP_K=4
LLM_MAX_TOKENS=512
